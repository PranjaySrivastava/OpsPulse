# OpenRouter AI Configuration (100% Free Models - Zero Credit Cost)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Fallback free model chain for automatic failover:
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.1-8b-instruct:free,google/gemini-2.0-flash-exp:free,qwen/qwen-2.5-coder-32b-instruct:free,mistralai/mistral-7b-instruct:free
SITE_URL=http://localhost:3000
SITE_NAME=OpsPulse

# CometChat Cloud Configuration
COMETCHAT_APP_ID=your_cometchat_app_id
COMETCHAT_REGION=us
COMETCHAT_AUTH_KEY=your_cometchat_auth_key
COMETCHAT_API_KEY=your_cometchat_rest_api_key

# Backend Server Port
PORT=3000
